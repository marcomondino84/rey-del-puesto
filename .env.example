# Puerto del servidor (configurar uno exclusivo para no interferir con mkcore en el VPS)
PORT=3050

# URL pública del proyecto (ej: http://localhost:3050 o https://robameelpuesto.tudominio.com)
BASE_URL=http://localhost:3050

# Credenciales de Mercado Pago (Access Token de Producción o Test)
# Si se deja vacío o 'TEST', el sistema permite simular el pago para pruebas de desarrollo
MP_ACCESS_TOKEN=TEST_ACCESS_TOKEN_AQUI

# Tasa de cambio de fallback si la API de DolarApi no responde (ARS por 1 USD)
DOLAR_BLUE_FALLBACK=1350

# Credenciales de acceso al Panel de Administración oculto
ADMIN_USER=admin
ADMIN_PASS=@dmin2026
